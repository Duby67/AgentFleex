{
  "description": "AgentFleex: an outline before the first whole read of a long file",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/agentfleex.py\" read",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
