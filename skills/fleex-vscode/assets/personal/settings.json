{
  "workbench.colorTheme": "One Dark Modern Classic",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "top",
  "workbench.panel.showLabels": false,
  "window.density.layout": "compact",
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 3,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,
  "chatgpt.reviewDelivery": "detached",
  "chatgpt.runCodexInWindowsSubsystemForLinux": true,
  "chatgpt.localeOverride": "ru-RU",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4o-mini",
  "chat.agent.enabled": false,
  "chat.viewSessions.enabled": false,
  "chat.contextUsage.enabled": false,
  "chat.checkpoints.enabled": false,
  "chat.customAgentInSubagent.enabled": false,
  "chat.undoRequests.restoreInput": false,
  "chat.agent.codeBlockProgress": false,
  "chat.agent.thinking.collapsedTools": "off",
  "chat.agent.thinking.generateTitles": false,
  "chat.agent.thinking.terminalTools": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false
}
