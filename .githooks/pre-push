#!/usr/bin/env bash
set -u

blocked_refs=()

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_ref:-}" ] || [ -z "${local_sha:-}" ] || \
    [ -z "${remote_ref:-}" ] || [ -z "${remote_sha:-}" ]; then
    echo 'pre-push guard: malformed ref update received; push blocked' >&2
    exit 1
  fi
  case "$remote_ref" in
    refs/heads/integration|refs/heads/dev|refs/heads/production)
      blocked_refs+=("${remote_ref#refs/heads/}")
      ;;
  esac
done

if [ "${#blocked_refs[@]}" -ne 0 ]; then
  for branch in "${blocked_refs[@]}"; do
    echo "pre-push guard: direct push to '$branch' is forbidden; use the required promotion PR" >&2
  done
  echo 'pre-push guard: allowed flow is task branch -> integration -> dev -> production' >&2
  exit 1
fi

exit 0
